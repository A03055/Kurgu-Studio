{
  "name": "kurgu-studio",
  "productName": "Kurgu Studio",
  "version": "1.1.0",
  "description": "Ücretsiz, reklamsız, filigransız video düzenleyici",
  "main": "electron/main.js",
  "author": "Kurgu Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kurgustudio.app",
    "productName": "Kurgu Studio",
    "copyright": "Kurgu Studio — özgür yazılım",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**/*",
      "fonts/**/*",
      "js/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kurgu Studio",
      "artifactName": "KurguStudio-Kurulum-${version}.${ext}",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055"
    },
    "portable": {
      "artifactName": "KurguStudio-Tasinabilir-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "artifactName": "KurguStudio-Mac-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KurguStudio-Linux-${version}.${ext}"
    }
  },
  "homepage": "https://github.com/A03055/CAPCUT-CAKMASI"
}
